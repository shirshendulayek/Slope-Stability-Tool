      "source": [
        "# Clone the required repositories\n",
        "!git clone https://github.com/sbadirli/GrowNet.git\n",
        "!git clone https://github.com/Tushar-Sarkar/XBNet.git\n",
        "!pip install optuna\n",
        "# Note: BoostResNet may need to be manually implemented based on research papers\n",
        "# as public repositories are often unstable."
      ]
